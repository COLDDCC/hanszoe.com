---
import '../styles/global.css';import {includeDemo} from '../lib/data';import HansMark from '../components/HansMark.astro';
const {home=false,title='韩吉档案馆',description='持续收录韩吉·佐耶的官方周边、发行记录、系列与角色资料。只记录当时官方价格。',image=null,ogType='website',structuredData=null}=Astro.props;
const site=Astro.site;const indexable=!!site&&import.meta.env.PUBLIC_INDEXABLE==='true'&&!includeDemo;const path=Astro.url.pathname;
const jaPath = /^\/(?:merch|series)\//.test(path) || path === '/' ? '/ja' + (path === '/' ? '/' : path) : null;
const nav=[['/wiki/','原作档案'],['/merch/','周边图录'],['/series/','系列档案'],['/news/','活动资讯'],['/about/','关于本站']];
const isCurrent=(href:string)=>path.startsWith(href);
const fullTitle=title==='韩吉档案馆'?title:title+' · 韩吉档案馆';
const pageUrl=site?new URL(path,site).href:null;
const ogImage=site?new URL(image||'/favicon-192.png',site).href:null;
const ld=structuredData?JSON.stringify(structuredData).replace(/</g,'\\u003c'):null;
---
<!doctype html><html lang="zh-CN"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{fullTitle}</title><meta name="description" content={description}/><meta name="robots" content={indexable?'index,follow':'noindex,nofollow'}/>{pageUrl&&<link rel="canonical" href={pageUrl}/>}{site&&jaPath&&<link rel="alternate" hreflang="zh-Hans" href={pageUrl}/>}{site&&jaPath&&<link rel="alternate" hreflang="ja" href={new URL(jaPath,site)}/>}{site&&jaPath&&<link rel="alternate" hreflang="x-default" href={pageUrl}/>}<meta property="og:site_name" content="韩吉档案馆"/><meta property="og:locale" content="zh_CN"/><meta property="og:type" content={ogType}/><meta property="og:title" content={fullTitle}/><meta property="og:description" content={description}/>{pageUrl&&<meta property="og:url" content={pageUrl}/>}{ogImage&&<meta property="og:image" content={ogImage}/>}<meta name="twitter:card" content={image?'summary_large_image':'summary'}/><link rel="icon" href="/favicon.ico" sizes="any"/><link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192"/><link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180"/><meta name="theme-color" content="#695083"/>{ld&&<script type="application/ld+json" set:html={ld}/>}</head><body><a class="skip" href="#main">跳到内容</a><header class:list={["masthead",{"is-home":home}]}><div class="masthead-inner"><a class="mast-logo" href="/"><HansMark/><span class="sr-only">韩吉档案馆 首页</span></a><a class="menu-toggle" href="#site-menu" aria-controls="site-menu" aria-expanded="false">MENU</a></div></header><div class="site-menu" id="site-menu" role="dialog" aria-modal="true" aria-label="网站菜单"><div class="site-menu-inner"><div class="site-menu-top"><a class="mast-logo" href="/"><HansMark/><span class="sr-only">韩吉档案馆 首页</span></a><a class="menu-close" href="#" aria-label="关闭菜单">CLOSE</a></div><nav aria-label="主导航"><a href="/" aria-current={path==='/'?'page':undefined}>首页</a>{nav.map(([href,label])=><a href={href} aria-current={isCurrent(href)?'page':undefined}>{label}</a>)}</nav><form class="menu-search" action="/merch/" role="search"><label class="sr-only" for="menu-q">搜索周边</label><input id="menu-q" name="q" placeholder="搜商品、系列或品牌"/><button>搜索</button></form><p class="menu-foot"><a href={jaPath||'/ja/'} lang="ja">日本語</a><span>韩吉档案馆 · 非官方粉丝档案</span></p></div></div>{includeDemo&&<div class="demo-banner">示例模式 · 标记“示例数据”的条目不是真实商品，正式构建默认排除。</div>}<main id="main"><slot/></main><footer><div><a class="footer-brand" href="/">韩吉档案馆 <span>Hange Archive</span></a><p>非官方粉丝档案 · 持续收录，保留出处。</p></div><div><a href="/about/">关于本站 · 收录规则与纠错</a><a href="/ja/merch/">日本語 · 周边记录</a><p>角色与商品的相关权利归原权利方所有。</p></div></footer><script is:inline>(()=>{const d=document,h=d.querySelector(".masthead"),m=d.getElementById("site-menu"),t=d.querySelector(".menu-toggle");if(!h||!m||!t)return;d.documentElement.classList.add("js");const set=o=>{m.classList.toggle("open",o);d.documentElement.classList.toggle("menu-lock",o);t.setAttribute("aria-expanded",String(o));if(o)m.querySelector("nav a")?.focus();else t.focus();};t.addEventListener("click",e=>{e.preventDefault();set(true)});m.querySelector(".menu-close").addEventListener("click",e=>{e.preventDefault();set(false)});d.addEventListener("keydown",e=>{if(e.key==="Escape"&&m.classList.contains("open"))set(false)});if(h.classList.contains("is-home")){const mark=d.querySelector(".cover-mark");const f=()=>h.classList.toggle("scrolled",mark?mark.getBoundingClientRect().bottom<56:scrollY>40);f();addEventListener("scroll",f,{passive:true});}else h.classList.add("scrolled");})();</script></body></html>
