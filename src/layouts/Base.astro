---
import '../styles/global.css';import {includeDemo} from '../lib/data';
const {title='韩吉档案馆',description='持续收录韩吉·佐耶的官方周边、发行记录、系列与角色资料。只记录当时官方价格。'}=Astro.props;
const site=Astro.site;const indexable=!!site&&import.meta.env.PUBLIC_INDEXABLE==='true'&&!includeDemo;const path=Astro.url.pathname;
const nav=[['/merch/','周边图录'],['/series/','系列档案'],['/news/','资讯'],['/wiki/','Wiki']];
---
<!doctype html><html lang="zh-CN"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title==='韩吉档案馆'?title:title+' · 韩吉档案馆'}</title><meta name="description" content={description}/><meta name="robots" content={indexable?'index,follow':'noindex,nofollow'}/>{site&&<link rel="canonical" href={new URL(path,site)}/>}<link rel="icon" href="/favicon.svg" type="image/svg+xml"/></head><body><a class="skip" href="#main">跳到内容</a><header><div class="header-inner"><a class="brand" href="/"><img src="/favicon.svg" alt="" width="38" height="38"/><span>韩吉档案馆<small>HANGE ARCHIVE</small></span></a><nav aria-label="主导航">{nav.map(([href,label])=><a href={href} aria-current={path.startsWith(href)?'page':undefined}>{label}</a>)}</nav><a class="about-link" href="/about/">关于本站</a></div></header>{includeDemo&&<div class="demo-banner">示例模式 · 标记“示例数据”的条目不是真实商品，正式构建默认排除。</div>}<main id="main"><slot/></main><footer><div><a class="footer-brand" href="/">韩吉档案馆 <span>Hange Archive</span></a><p>非官方粉丝档案 · 持续收录，保留出处。</p></div><div><a href="/about/">收录规则与纠错</a><p>角色与商品的相关权利归原权利方所有。</p></div></footer></body></html>
