---
import '../styles/global.css';import {includeDemo} from '../lib/data';import Masthead from '../components/Masthead.astro';
const {home=false,title='韩吉档案馆',description='持续收录韩吉·佐耶的官方周边、发行记录、系列与角色资料。只记录当时官方价格。',image=null,ogType='website',structuredData=null}=Astro.props;
const site=Astro.site;const indexable=!!site&&import.meta.env.PUBLIC_INDEXABLE==='true'&&!includeDemo;const path=Astro.url.pathname;
// 有日文对应页的路径：中文首页 /zh/ ↔ /ja/，图录与系列 ↔ /ja/ 前缀。其余页面暂无日文版，语言切换回到日文首页。
const jaPath = path === '/zh/' ? '/ja/' : /^\/(?:merch|series)\//.test(path) ? '/ja' + path : null;
const nav=[['/wiki/','原作档案'],['/merch/','周边图录'],['/series/','系列档案'],['/news/','活动资讯'],['/about/','关于本站']];
const isCurrent=(href:string)=>path.startsWith(href);
const fullTitle=title==='韩吉档案馆'?title:title+' · 韩吉档案馆';
const pageUrl=site?new URL(path,site).href:null;
const ogImage=site?new URL(image||'/favicon-192.png',site).href:null;
const ld=structuredData?JSON.stringify(structuredData).replace(/</g,'\\u003c'):null;
---
<!doctype html><html lang="zh-CN"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{fullTitle}</title><meta name="description" content={description}/><meta name="robots" content={indexable?'index,follow':'noindex,nofollow'}/>{pageUrl&&<link rel="canonical" href={pageUrl}/>}{site&&jaPath&&<link rel="alternate" hreflang="zh-Hans" href={pageUrl}/>}{site&&jaPath&&<link rel="alternate" hreflang="ja" href={new URL(jaPath,site)}/>}{site&&jaPath&&<link rel="alternate" hreflang="x-default" href={new URL(jaPath,site)}/>}<meta property="og:site_name" content="韩吉档案馆"/><meta property="og:locale" content="zh_CN"/><meta property="og:type" content={ogType}/><meta property="og:title" content={fullTitle}/><meta property="og:description" content={description}/>{pageUrl&&<meta property="og:url" content={pageUrl}/>}{ogImage&&<meta property="og:image" content={ogImage}/>}<meta name="twitter:card" content={image?'summary_large_image':'summary'}/><link rel="icon" href="/favicon.ico" sizes="any"/><link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192"/><link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180"/><meta name="theme-color" content="#695083"/>{ld&&<script type="application/ld+json" set:html={ld}/>}</head><body><a class="skip" href="#main">跳到内容</a><Masthead home={home} lang="zh" homeHref="/zh/" zhHref={path} jaHref={jaPath||'/ja/'} nav={[{href:'/zh/',label:'首页',current:path==='/zh/'},...nav.map(([href,label])=>({href,label,current:isCurrent(href)}))]} search={{action:'/merch/',placeholder:'搜商品、系列或品牌',label:'搜索周边',button:'搜索'}} t={{logo:'韩吉档案馆 首页',menuAria:'网站菜单',navAria:'主导航',close:'关闭菜单',foot:'韩吉档案馆 · 非官方粉丝档案'}}/>{includeDemo&&<div class="demo-banner">示例模式 · 标记“示例数据”的条目不是真实商品，正式构建默认排除。</div>}<main id="main"><slot/></main><footer><div><a class="footer-brand" href="/zh/">韩吉档案馆 <span>Hange Archive</span></a><p>非官方粉丝档案 · 持续收录，保留出处。</p></div><div><a href="/about/">关于本站 · 收录规则与纠错</a><a href="/ja/merch/">日本語 · 周边记录</a><p>角色与商品的相关权利归原权利方所有。</p></div></footer></body></html>
