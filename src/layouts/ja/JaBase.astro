---
import '../../styles/global.css';
import { includeDemo } from '../../lib/data';
import { jaUi } from '../../lib/ja';

const {
  title = jaUi.siteTitle,
  description = '進撃の巨人のハンジ・ゾエに関する公式グッズを、発売・公式価格・出典つきで収録するアーカイブ。',
} = Astro.props;

const site = Astro.site;
const indexable = !!site && import.meta.env.PUBLIC_INDEXABLE === 'true' && !includeDemo;
const path = Astro.url.pathname;
const zhPath = path.replace(/^\/ja(\/|$)/, '$1');
const nav = [['/ja/merch/', jaUi.navMerch], ['/ja/series/', jaUi.seriesFile]];
const isCurrent = (href: string) =>
  path.startsWith(href) || (href === '/ja/merch/' && path.startsWith('/ja/series/'));
---

<!doctype html><html lang="ja"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><title>{title === jaUi.siteTitle ? title : title + ' · ' + jaUi.siteTitle}</title><meta name="description" content={description} /><meta name="robots" content={indexable ? 'index,follow' : 'noindex,nofollow'} />{site && <link rel="canonical" href={new URL(path, site)} />}{site && <link rel="alternate" hreflang="ja" href={new URL(path, site)} />}{site && <link rel="alternate" hreflang="zh-Hans" href={new URL(zhPath, site)} />}<link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin /><link href="https://fonts.googleapis.com/css2?family=EB+Garamond:wght@400;500;600;800&amp;family=Zen+Old+Mincho:wght@500;600;800&amp;display=swap" rel="stylesheet" /><link rel="icon" href="/favicon.ico" sizes="any" /><link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" /><link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" /><meta name="theme-color" content="#695083" /><meta property="og:locale" content="ja_JP" /></head><body><a class="skip" href="#main">本文へスキップ</a><header><div class="header-inner"><a class="brand" href="/ja/"><img src="/favicon.svg" alt="" width="38" height="38" /><span>ハンジ・ゾエ アーカイブ<small>HANGE ARCHIVE</small></span></a><nav aria-label="メインナビゲーション">{nav.map(([href, label]) => <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>)}<a href={zhPath} class="lang-switch" title="中文頁面">中文</a></nav></div></header>{includeDemo && <div class="demo-banner">デモモード · 「デモデータ」の項目は実在の商品ではありません。本番ビルドでは既定で除外されます。</div>}<main id="main"><slot /></main><footer><div><a class="footer-brand" href="/ja/">ハンジ・ゾエ アーカイブ <span>Hange Archive</span></a><p>非公式のファンアーカイブ · 出典を残しながら収録中。</p></div><div><a href="/ja/merch/">日本語版 グッズ図録</a><p>キャラクターおよび商品の権利は各権利者に帰属します。</p></div></footer></body></html>

<style is:global>
  .lang-switch {
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 2px 10px !important;
    font-size: 0.78rem;
    letter-spacing: 0.06em;
  }
</style>
