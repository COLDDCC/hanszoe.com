---
import '../../styles/global.css';
import { includeDemo } from '../../lib/data';
import { jaUi } from '../../lib/ja';
import Masthead from '../../components/Masthead.astro';

const {
  home = false,
  title = jaUi.siteTitle,
  description = '進撃の巨人のハンジ・ゾエに関する公式グッズを、発売・公式価格・出典つきで収録するアーカイブ。',
  structuredData = null,
  image = null,
  ogType = 'website',
} = Astro.props;

const site = Astro.site;
const indexable = !!site && import.meta.env.PUBLIC_INDEXABLE === 'true' && !includeDemo;
const path = Astro.url.pathname;
// 对应的中文页：日文首页 /ja/ ↔ 中文首页 /zh/，其余去掉 /ja 前缀。
const zhPath = path === '/ja/' ? '/zh/' : path.replace(/^\/ja(\/|$)/, '$1');
const nav = [
  { href: '/ja/', label: jaUi.navHome, current: path === '/ja/' },
  { href: '/ja/merch/', label: jaUi.navMerch, current: path.startsWith('/ja/merch/') },
  { href: '/ja/series/', label: jaUi.seriesIndexTitle, current: path.startsWith('/ja/series/') },
  { href: '/news/', label: jaUi.navNews, note: '中国語' },
  { href: '/wiki/', label: jaUi.navWiki, note: '中国語' },
  { href: '/about/', label: '収録について', note: '中国語' },
];
const fullTitle = title === jaUi.siteTitle || title.includes('｜') ? title : title + ' · ' + jaUi.siteTitle;
const pageUrl = site ? new URL(path, site).href : null;
const ogImage = site ? new URL(image || '/favicon-192.png', site).href : null;
---

<!doctype html><html lang="ja"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><title>{fullTitle}</title><meta name="description" content={description} /><meta name="robots" content={indexable ? 'index,follow' : 'noindex,nofollow'} />{site && <link rel="canonical" href={new URL(path, site)} />}{site && <link rel="alternate" hreflang="ja" href={new URL(path, site)} />}{site && <link rel="alternate" hreflang="zh-Hans" href={new URL(zhPath, site)} />}{site && <link rel="alternate" hreflang="x-default" href={new URL(path, site)} />}<meta property="og:site_name" content={jaUi.siteTitle} /><meta property="og:type" content={ogType} /><meta property="og:title" content={fullTitle} /><meta property="og:description" content={description} />{pageUrl && <meta property="og:url" content={pageUrl} />}{ogImage && <meta property="og:image" content={ogImage} />}<meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} /><link rel="icon" href="/favicon.ico" sizes="any" /><link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" /><link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" /><meta name="theme-color" content="#695083" /><meta property="og:locale" content="ja_JP" />{structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")} />}</head><body><a class="skip" href="#main">本文へスキップ</a><Masthead home={home} lang="ja" homeHref="/ja/" zhHref={zhPath} jaHref={path} nav={nav} search={{ action: '/ja/merch/', placeholder: 'グッズ名・シリーズ・メーカーで検索', label: jaUi.searchLabel, button: jaUi.search }} t={{ logo: 'ハンジ・ゾエ アーカイブ トップ', menuAria: 'サイトメニュー', navAria: 'メインナビゲーション', close: 'メニューを閉じる', foot: 'ハンジ・ゾエ アーカイブ · 非公式ファンアーカイブ' }} />{includeDemo && <div class="demo-banner">デモモード · 「デモデータ」の項目は実在の商品ではありません。本番ビルドでは既定で除外されます。</div>}<main id="main"><slot /></main><footer><div><a class="footer-brand" href="/ja/">ハンジ・ゾエ アーカイブ <span>Hange Archive</span></a><p>非公式のファンアーカイブ · 出典を残しながら収録中。</p></div><div><a href="/ja/merch/">日本語版 グッズ図録</a><a href="/zh/" data-set-lang="zh" lang="zh-Hans">中文版 · 韩吉档案馆</a><p>キャラクターおよび商品の権利は各権利者に帰属します。</p></div></footer></body></html>

