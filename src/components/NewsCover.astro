---
// 杂志封面式资讯区：头条大图｜纯标题列表｜右栏图卡。首页带 Hans 大字标（mark），活动资讯页不带。
import type { CollectionEntry } from 'astro:content';
import HansMark from './HansMark.astro';
import { webpSize } from '../lib/imageSize';
import { pickCover, longDate, dotDate } from '../lib/newsCover';
type News = CollectionEntry<'news'>;
interface Props { news: News[]; mark?: boolean; moreLink?: boolean; label?: string }
const { news, mark = false, moreLink = false, label = '最新资讯' } = Astro.props;
const { lead, rail, textList } = pickCover(news);
const [pairA, pairB, feature] = rail;
const pair = [pairA, pairB].filter((n): n is News => !!n);
const href = (n: News) => '/news/' + n.data.slug + '/';
const sourceOf = (n: News) => n.data.sources[0]?.organization;
const dim = (n: News) => (n.data.cover && webpSize(n.data.cover.path)) || {};
---
<section class:list={['cover', { 'cover--plain': !mark }]} aria-label={label}>
<div class="cover-lead">
{mark && <p class="cover-date">{lead ? <time datetime={lead.data.publishedAt}>{longDate(lead.data.publishedAt)}</time> : 'HANGE ARCHIVE'}</p>}
{mark && <div class="cover-mark" aria-hidden="true" data-mast-anchor><HansMark/></div>}
{lead && <a class="cover-lead-story" href={href(lead)}><figure class="cover-lead-media"><img {...dim(lead)} src={lead.data.cover!.path} alt={lead.data.cover!.alt} loading="eager" fetchpriority="high" decoding="async"/></figure><span class="kicker">{lead.data.category}{!mark && <> · <time datetime={lead.data.publishedAt}>{dotDate(lead.data.publishedAt)}</time></>}</span><h2>{lead.data.title}</h2><p>{lead.data.summary}</p>{sourceOf(lead) && <small class="byline">出处 · {sourceOf(lead)}</small>}</a>}
</div>
<ol class="cover-list">{textList.map(n => <li><a href={href(n)}><time datetime={n.data.publishedAt}>{dotDate(n.data.publishedAt)}</time><h3>{n.data.title}</h3></a></li>)}{moreLink && <li class="cover-list-more"><a href="/news/">全部活动资讯 →</a></li>}</ol>
<div class="cover-rail">
{pair.length > 0 && <div class="cover-pair">{pair.map(n => <a class="cover-card" href={href(n)}><span class="cover-card-media"><img {...dim(n)} src={n.data.cover!.path} alt={n.data.cover!.alt} loading="lazy" decoding="async"/></span><span class="kicker">{n.data.category}</span><h3>{n.data.title}</h3></a>)}</div>}
{feature && <a class="cover-feature" href={href(feature)}><span class="kicker">{feature.data.category}</span><h2>{feature.data.title}</h2><div class="cover-feature-body"><span class="cover-feature-media"><img {...dim(feature)} src={feature.data.cover!.path} alt={feature.data.cover!.alt} loading="lazy" decoding="async"/></span><p>{feature.data.summary}</p></div></a>}
</div>
</section>
