---
import Base from '../../../layouts/ja/JaBase.astro';
import Card from '../../../components/JaProductCard.astro';
import { products, series } from '../../../lib/data';
import { jaUi, jaSeriesName, jaSeriesType, seriesJa } from '../../../lib/ja';

export function getStaticPaths() {
  return series.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
const { s } = Astro.props;
const items = products.filter((p) => p.seriesId === s.id);
const nameJa = jaSeriesName(s) || s.slug;
const doc = seriesJa(s);
---

<Base title={nameJa} description={doc.description || `${nameJa} の商品を、発売・公式価格・出典つきで収録する日本語版のシリーズ記録。`}>
  <div class="breadcrumbs">
    <a href="/ja/series/">{jaUi.seriesIndexTitle}</a><span>/</span><span>{jaSeriesType[s.type] ?? s.type}</span>
  </div>

  <div class="page-heading">
    <span class="eyebrow">日本 / SERIES FILE</span>
    <h1>{nameJa}</h1>
    {doc.description ? (
      <p>{doc.description}</p>
    ) : (
      <p>このシリーズの日本語説明は作成中です。収録商品は {items.length} 件、出典 {s.sources.length} 件。</p>
    )}
    {!jaSeriesName(s) && (
      <p class="zh-line"><span class="zh-tag">中国語アーカイブ名</span> <span lang="zh-Hans">{s.name}</span></p>
    )}
  </div>

  <section>
    <div class="section-heading">
      <h2>シリーズのグッズ</h2>
      <span>{items.length} 件収録</span>
    </div>
    {items.length ? (
      <div class="product-grid">{items.map((p) => <Card product={p} seriesList={series} />)}</div>
    ) : (
      <div class="empty">このシリーズの商品は確認中です。</div>
    )}
  </section>

  <section class="sources">
    <h2>{jaUi.sources}</h2>
    {s.sources.length ? (
      s.sources.map((src: any) => (
        <div>
          <a href={src.url} target="_blank" rel="noopener noreferrer">{src.title} ↗</a>
          <p>{src.organization} · {jaUi.checkedAt} {src.checkedAt}</p>
        </div>
      ))
    ) : (
      <p>{jaUi.sourceNone}</p>
    )}
  </section>

  <p class="zh-link">
    <a href={`/series/${s.slug}/`}>中国語版のこのシリーズ（関連イベント情報つき）↗</a>
  </p>
</Base>

<style>
  .zh-line { margin-top: 8px; font-size: .9rem; color: var(--muted); }
  .zh-tag { display: inline-block; border: 1px solid var(--line); border-radius: 999px; padding: 1px 8px; font-size: .7rem; }
  .zh-link { margin-top: 20px; font-size: .84rem; }
</style>
