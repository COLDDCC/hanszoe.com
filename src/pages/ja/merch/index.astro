---
import Base from '../../../layouts/ja/JaBase.astro';
import Card from '../../../components/JaProductCard.astro';
import { products, series } from '../../../lib/data';
import { jaUi, jaType, jaSalesMethod, jaYear, jaName } from '../../../lib/ja';
import { firstDate } from '../../../lib/catalog';
import { buildIndex, filterIndex, PAGE_SIZE } from '../../../lib/catalogIndex';

const index = buildIndex(products, series, { year: jaYear, date: firstDate, name: jaName });
const order = new Map(filterIndex(index, new URLSearchParams(), 'ja').map((e, i) => [e.id, i]));
const ordered = [...products].sort((a, b) => order.get(a.id)! - order.get(b.id)!);

const groups = [
  {
    key: 'year',
    label: '発売年',
    values: [...new Set(products.map(jaYear).filter(Boolean))].sort().reverse().map((v) => [v, `${v}年`]),
  },
  {
    key: 'type',
    label: '商品カテゴリ',
    values: [...new Set(products.map((p) => p.type))].map((v) => [v, jaType[v] ?? v]),
  },
  {
    key: 'method',
    label: '販売形態',
    values: [...new Set(products.flatMap((p) => p.releases.map((r) => r.salesMethod)))].map(
      (v) => [v, jaSalesMethod[v] ?? v],
    ),
  },
];
const makers = new Map<string, number>();
for (const p of products) {
  const v = p.manufacturer || p.publisher;
  if (v && !/^(未注明|待核实|未知)$/.test(v)) makers.set(v, (makers.get(v) || 0) + 1);
}
const topMakers = [...makers].sort((a, b) => b[1] - a[1]).slice(0, 2).map(([v]) => v);
---

<Base title="ハンジ・ゾエ グッズ一覧｜公式グッズ・発売情報" description="進撃の巨人・ハンジのグッズを発売年、カテゴリ、シリーズから検索。アクリルスタンド、缶バッジ、ぬいぐるみなどの公式商品と発売記録を出典つきで収録。">
  <div class="page-heading">
    <span class="eyebrow">THE COLLECTION · 日本語版</span>
    <h1>ハンジ・ゾエ グッズ一覧</h1>
    <p>発売年・カテゴリ・販売形態で絞り込めます。シリーズとメーカーはカードのタグになっているので、タップすると同種の商品まとめて表示されます。</p>
    <nav class="section-nav" aria-label="グッズ図録のセクション">
      <a href="/ja/merch/" aria-current="page">すべてのグッズ</a>
      <a href="/ja/series/">シリーズ一覧</a>
    </nav>
  </div>

  <form id="catalog-form">
    <div class="catalog-search">
      <label class="sr-only" for="q">{jaUi.searchLabel}</label>
      <input type="search" name="q" id="q" placeholder={jaUi.searchLabel} />
      <button class="button" type="submit">{jaUi.search}</button>
    </div>
    <div class="search-hints">
      <span>例：</span>
      <a href="/ja/merch/?q=%E3%83%8F%E3%83%B3%E3%82%B8">ハンジ</a>
      {topMakers.map((v) => <a href={`/ja/merch/?q=${encodeURIComponent(v)}`}>メーカー · {v}</a>)}
    </div>

    <div class="catalog-layout">
      <aside class="filters">
        <details open id="filter-details">
          <summary>{jaUi.filterTitle}</summary>
          {groups.map((g) => (
            <fieldset>
              <legend>{g.label}</legend>
              {g.values.map(([v, label]) => (
                <label>
                  <input type="checkbox" name={g.key} value={v} />
                  <span>{label}</span>
                </label>
              ))}
            </fieldset>
          ))}
          <button type="reset" class="clear-button">{jaUi.filterClear}</button>
        </details>
      </aside>

      <div class="results">
        <div class="result-toolbar">
          <p aria-live="polite">
            {jaUi.foundPrefix} <strong id="result-count">{products.length}</strong> {jaUi.foundUnit}
          </p>
          <label for="sort">
            {jaUi.sortLabel}
            <select id="sort" name="sort">
              <option value="added">{jaUi.sortAdded}</option>
              <option value="date">{jaUi.sortDate}</option>
              <option value="name">{jaUi.sortName}</option>
            </select>
          </label>
        </div>
        <div class="product-grid" id="product-grid">
          {ordered.map((p, i) => <Card product={p} seriesList={series} hidden={i >= PAGE_SIZE} />)}
        </div>
        <div class="load-more" id="load-more" hidden>
          <button type="button" class="button secondary" id="load-more-button">さらに表示</button>
        </div>
        <noscript><style is:inline>.product-card[hidden]{display:block}</style></noscript>
        <div class="empty" id="no-results" hidden>
          <h2>{jaUi.noResultTitle}</h2>
          <p>{jaUi.noResultBody}</p>
          <button type="reset" class="button">{jaUi.filterClear}</button>
        </div>
        <p class="list-footnote">発売年は初回の発売年。販売形態は収録済みのいずれかの発売に一致すれば表示されます。</p>
      </div>
    </div>
  </form>

  <script type="application/json" id="catalog-data" set:html={JSON.stringify({ products: index }).replace(/</g, '\\u003c')} />
  <script>
    import { initCatalog } from '../../../lib/catalogPage';
    initCatalog({ locale: 'ja', moreLabel: (n) => `さらに表示（残り ${n} 件）` });
  </script>
</Base>
