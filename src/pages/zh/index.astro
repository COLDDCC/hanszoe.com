---
import Base from '../../layouts/Base.astro';import MagCover from '../../components/MagCover.astro';import {pickCover,newsHasCover,newsItem} from '../../lib/cover';import Card from '../../components/ProductCard.astro';import {products,series} from '../../lib/data';import {getCollection} from 'astro:content';const news=(await getCollection('news',x=>!x.data.isDemo)).sort((a,b)=>b.data.publishedAt.localeCompare(a.data.publishedAt));
// 最新收录：与图录页「最新收录」排序一致（按收录日 createdAt 倒序）。
const latest=[...products].sort((a,b)=>b.createdAt.localeCompare(a.createdAt)).slice(0,4);
// 系列：首页只展示最近有新收录的 6 个系列，其余从「全部系列」进入。
const seriesStats=new Map(series.map(s=>[s.id,{count:0,latest:''}]));
for(const p of products){const st=seriesStats.get(p.seriesId);if(st){st.count++;if(p.createdAt>st.latest)st.latest=p.createdAt;}}
const featuredSeries=series.filter(s=>seriesStats.get(s.id)!.count>0).sort((a,b)=>seriesStats.get(b.id)!.latest.localeCompare(seriesStats.get(a.id)!.latest)||seriesStats.get(b.id)!.count-seriesStats.get(a.id)!.count).slice(0,6);
// 杂志封面区（MagCover）已用掉的资讯，下方「活动资讯」栏跳过它们。
const {used}=pickCover(news,newsHasCover);
const restNews=news.filter(n=>!used.has(n));
// 站点名称结构化数据：Google 用首页的 WebSite 标记决定搜索结果里显示的网站名。
const siteLd=Astro.site?{'@context':'https://schema.org','@type':'WebSite',name:'韩吉档案馆',alternateName:['Hans','Hange Archive'],url:new URL('/zh/',Astro.site).href,inLanguage:'zh-CN'}:null;
---
<Base home structuredData={siteLd}><section class="search-hero"><div class="search-hero-inner"><img class="hero-logo" src="/favicon.svg" width="72" height="72" alt="" decoding="async"/><h1 class="hero-title"><span class="hero-title-zh">韩吉档案馆</span><span class="hero-title-en" lang="en">HANGE ZOË ARCHIVE</span></h1><p class="hero-sub">韩吉·佐耶的官方周边、发行记录与角色资料</p><form class="hero-search" action="/merch/" role="search"><label class="sr-only" for="home-search">搜索周边</label><svg class="hero-search-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg><input id="home-search" name="q" type="search" placeholder="搜索周边：商品名、系列或品牌，支持中 / 日 / 英文" autocomplete="off" enterkeyhint="search"/><button aria-label="搜索图录"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button></form><nav class="hero-links" aria-label="快速入口"><a href="/merch/"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z"/></svg>周边图录</a><a href="/series/"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 3 2 8l10 5 10-5-10-5zM2 13l10 5 10-5M2 18l10 5 10-5"/></svg>系列档案</a><a href="/news/"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 4h11v16H5zM16 8h3v10a2 2 0 0 1-2 2M8 8h5M8 12h5M8 16h3"/></svg>活动资讯</a><a href="/wiki/"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 5a2 2 0 0 1 2-2h13v16H6a2 2 0 0 0-2 2zM4 21V5M8 7h7"/></svg>原作档案</a></nav><p class="hero-hints"><span>试试：</span><a href="/merch/?q=1123">黏土人 1123</a><a href="/merch/?q=ハンジ" lang="ja">ハンジ</a><a href="/merch/?q=MEGAHOUSE">MegaHouse</a></p><p class="hero-count">已收录 {products.length} 件周边 · {series.length} 个系列 · 只记录官方原价</p></div></section><MagCover items={news.map(newsItem)} mark label="最新资讯" more={{href:'/news/',label:'全部活动资讯 →'}}/><section class="home-intro"><div class="intro-copy"><div class="eyebrow">HANGE ZOË <span class="hero-name" lang="ja">ハンジ・ゾエ</span></div><h2 class="intro-title">关于韩吉，<br/>一件一件地记录。</h2><p>官方周边、发行记录与角色资料。<br/>为每一件收藏，留下一份有出处的档案。</p></div><aside class="archive-note"><span class="note-number">01 / ARCHIVE</span><div class="glasses" aria-hidden="true"><i></i><i></i></div><h2>让喜欢有迹可循。</h2><p>只记录发行时官方价格<br/>区分初版、再贩与不同版本<br/>未知的信息，留待核实</p><div class="note-bottom">非官方 · 持续收录</div></aside></section><div class="archive-stats"><div><strong>{products.length.toString().padStart(2,'0')}</strong><span>已收录周边</span></div><div><strong>{series.length.toString().padStart(2,'0')}</strong><span>系列档案</span></div><div><strong>{products.reduce((n,p)=>n+p.releases.length,0).toString().padStart(2,'0')}</strong><span>发行记录</span></div><p>从小小的档案开始，<br/>慢慢补全每一段记录。</p></div><section><div class="section-heading"><div><span class="eyebrow">THE COLLECTION</span><h2>最新收录</h2></div><a href="/merch/">浏览全部周边</a></div><div class="home-catalog"><div class="product-grid">{latest.map(p=><Card product={p}/>)}</div><aside class="collection-note"><span class="eyebrow">收藏之前，先看出处</span><h3>同一件周边，<br/>可以有不同发行记录。</h3><p>原价跟随每次发行保存。整盒、盲抽和特典，各自保留官方公布的单位。</p><a class="text-link" href="/about/">了解收录规则</a></aside></div></section><section class="two-columns"><div><div class="section-heading"><div><span class="eyebrow">SERIES FILES</span><h2>系列档案</h2></div><a href="/series/">全部 {series.length} 个系列</a></div>{featuredSeries.map((s,i)=><a class="series-row" href={'/series/'+s.slug+'/'}><span class="row-number">{String(i+1).padStart(2,'0')}</span><div><h3>{s.name}</h3><p>{s.type} · 日本 · {seriesStats.get(s.id)!.count} 件周边</p></div><span>查看档案</span></a>)}</div><div><div class="section-heading"><div><span class="eyebrow">NEWS & RELEASES</span><h2>活动资讯</h2></div><a href="/news/">全部活动资讯</a></div>{restNews.slice(0,3).map(n=><a class="news-row" href={'/news/'+n.data.slug+'/'}><small>{n.data.category} · {n.data.publishedAt}</small><h3>{n.data.title}</h3><p>{n.data.summary}</p></a>)}</div></section><section class="wiki-strip"><div><span class="eyebrow">THE PERSON BEHIND THE COLLECTION</span><h2>不止是周边，也是韩吉。</h2><p>名称索引、基础资料与登场记录，逐条核对，慢慢整理。</p></div><a class="button light" href="/wiki/">查看原作档案</a></section></Base>
