---
import Base from '../../layouts/Base.astro';import {getCollection} from 'astro:content';import {canonNotes} from '../../lib/data';const entries=(await getCollection('wiki',e=>!e.data.isDemo)).sort((a,b)=>b.data.updatedAt.localeCompare(a.data.updatedAt));const notesLatest=canonNotes.map(n=>n.updatedAt).sort().at(-1)||'';
---
<Base title="原作档案"><div class="page-heading"><span class="eyebrow">CHARACTER NOTES</span><h1>原作档案</h1><p>从名称与基础资料开始，逐条核对角色的记录。</p></div><div class="article-list">{canonNotes.length>0&&<a class="news-row" href="/wiki/creator-notes/"><small>{notesLatest} · {canonNotes.length} 条记录 · 逐条出处</small><h2>作者补充与读者问答</h2><p>谏山创在单行本附录、公式书与访谈里对韩吉的说明，每条单独记录出处、引用方式与核对日期。</p><span class="text-link">查看记录</span></a>}{entries.map(e=><a class="news-row" href={'/wiki/'+e.data.slug+'/'}><small>{e.data.updatedAt} · { e.data.spoiler==='无'?'无剧透':'剧透提示：'+e.data.spoiler }</small><h2>{e.data.title}</h2><p>{e.data.summary}</p><span class="text-link">阅读档案</span></a>)}</div>{!entries.length&&<div class="empty">资料正在整理，核实后将收录在这里。</div>}</Base>
