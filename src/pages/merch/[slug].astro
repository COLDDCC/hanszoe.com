---
import Base from '../../layouts/Base.astro';import Card from '../../components/ProductCard.astro';import Sources from '../../components/Sources.astro';import Featured from '../../components/ProductDetailFeatured.astro';import {existsSync} from 'node:fs';import {products,series} from '../../lib/data';import {dateText,displayName,priceText,usableBrand,seoDescription} from '../../lib/catalog';
export function getStaticPaths(){return products.map(p=>({params:{slug:p.slug},props:{p}}));}const {p}=Astro.props;const s=series.find(s=>s.id===p.seriesId)!;const related=products.filter(x=>x.id!==p.id&&(x.seriesId===p.seriesId||p.relatedProductIds.includes(x.id)));const first=p.releases.find(r=>r.kind==='初版')!;const buy=[...new Map(p.sources.filter(x=>!/prtimes\.jp|aot-portal\.com/.test(x.url)).map(x=>[x.url.replace(/\/+$/,'').split('#')[0].toLowerCase(),x])).values()];
const sameName=products.some(x=>x.id!==p.id&&displayName(x)===displayName(p));
const pageTitle=sameName&&p.names.ja?`${displayName(p)}（${p.names.ja}）`:displayName(p);
// 新版详情页先只在黏土人系列启用，其余商品沿用旧版。
const featured=p.seriesId==='nendoroid';
// SVG 不能作分享卡片图；有同名 JPEG（public/images/products/<id>-og.jpg）时改用它。
const ogJpg=`/images/products/${p.id}-og.jpg`;const shareImage=featured&&existsSync('public'+ogJpg)?ogJpg:p.images[0]?.path;
const abs=(u:string)=>new URL(u,Astro.site||Astro.url).href;
// Historical merchandise records are archive pages, not current offers or reviews.
const structuredData=[{'@context':'https://schema.org','@type':'WebPage',name:displayName(p),...(p.names.ja?{alternateName:p.names.ja}:{}),description:p.description,url:abs('/merch/'+p.slug+'/'),...(p.images.length?{image:p.images.map(i=>abs(i.path))}:{}),inLanguage:'zh-CN',about:{'@type':'Thing',name:displayName(p),...(p.names.ja?{alternateName:p.names.ja}:{})}},{'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'韩吉档案馆',item:abs('/')},{'@type':'ListItem',position:2,name:'周边图录',item:abs('/merch/')},{'@type':'ListItem',position:3,name:s.name,item:abs('/series/'+s.slug+'/')},{'@type':'ListItem',position:4,name:displayName(p)}]}];
---
<Base title={pageTitle} description={seoDescription(p,s.name)} image={shareImage} ogType="product" structuredData={structuredData}><div class="breadcrumbs"><a href="/merch/">周边图录</a><span>/</span><a href={'/series/'+s.slug+'/'}>{s.name}</a>{featured&&p.specifications['官方编号']&&<><span>/</span><span>No.{p.specifications['官方编号']}</span></>}</div>{featured?<Featured p={p} s={s}/>:<><section class="product-detail"><div class="detail-gallery">{p.images.length?p.images.map(img=><figure><img src={img.path} alt={img.alt}/><figcaption>{img.credit} · {img.usage} <a href={img.sourceUrl} target="_blank" rel="noopener noreferrer">图片来源 ↗</a>{img.originalUrl&&<> · <a href={img.originalUrl} target="_blank" rel="noopener noreferrer">原图网址 ↗</a></>}</figcaption></figure>):<div class="placeholder large"><span class="frame-icon">▧</span><span>商品图片待补充</span><small>等待可使用的官方图片或自有实拍</small></div>}</div><div class="detail-info"><span class="eyebrow">{p.type} / {p.region}</span><h1>{displayName(p)}</h1><p class="ja">{p.names.ja}</p><p>{p.description}</p>{buy.length>0&&<div class="buy-box"><span class="buy-kicker">可购买的网站</span><div class="buy-links">{buy.map(source=><a class="buy-btn" href={source.url} target="_blank" rel="noopener noreferrer"><span class="buy-shop">{source.organization}</span><span class="buy-host">{new URL(source.url).host}</span><span class="buy-go">前往 ↗</span></a>)}</div><small class="buy-note">点上方按钮跳转到该商城的官方商品页。本站只做档案，不出售、不代收、不代查二手价。</small></div>}<dl><div><dt>官方售价</dt><dd>{priceText(first)}{p.releases.length>1&&`（另有 ${p.releases.length-1} 次发行，见下方记录）`}</dd></div><div><dt>发售日</dt><dd>{first.releaseDate?dateText(first.releaseDate):(p.specifications['发售窗口']?'未公布，仅有滚动发售窗口（见下方规格）':'日期待确认')}</dd></div><div><dt>系列</dt><dd><a href={'/series/'+s.slug+'/'}>{s.name}</a></dd></div><div><dt>制造商</dt><dd>{usableBrand(p.manufacturer)?<a href={'/merch/?q='+encodeURIComponent(p.manufacturer!)}>{p.manufacturer}</a>:(p.manufacturer||'待核实')}</dd></div><div><dt>发行方</dt><dd>{usableBrand(p.publisher)?<a href={'/merch/?q='+encodeURIComponent(p.publisher!)}>{p.publisher}</a>:(p.publisher||'待核实')}</dd></div>{Object.entries(p.specifications).map(([k,v])=><div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>{p.isDemo&&<p class="notice">示例数据，不是真实商品。</p>}{p.missingFields.length>0&&<div class="notice"><strong>待核实项目</strong><ul>{p.missingFields.map(x=><li>{x}</li>)}</ul></div>}</div></section><section class="release-section"><div class="section-heading"><div><span class="eyebrow">RELEASE HISTORY</span><h2>发行与官方价格记录</h2></div><span>{p.releases.length} 次发行</span></div><p>以下为各次发行的官方标价，单位与税务状态分别保留。</p>{p.releases.map(r=><article class="release-card"><div class="release-date"><span class="tag">{r.kind}</span><h3>{dateText(r.releaseDate)}</h3><small>{r.region} · {r.salesMethod}</small></div><div><strong class="price">{priceText(r)}</strong><dl><div><dt>公告日期</dt><dd>{dateText(r.announcement)}</dd></div><div><dt>预订区间</dt><dd>{dateText(r.preorderStart)} — {dateText(r.preorderEnd)}（日本时区）</dd></div><div><dt>限定范围</dt><dd>{r.limitedScope||'官方来源未注明'}</dd></div>{r.condition&&<div><dt>获取条件</dt><dd>{r.condition}</dd></div>}</dl><div class="release-sources">{r.sourceIds.map(id=>{const source=p.sources.find(x=>x.id===id)!;return <a href={source.url} target="_blank" rel="noopener noreferrer">{source.title} ↗</a>})}</div></div></article>)}</section><section class="article"><h2>版本说明</h2><p>本条目按同一商品保留发行记录。不同年份的官方价格分别展示；设计或规格发生实质变化时，将另建条目并关联。</p><p>收录于 {p.createdAt} · 更新于 {p.updatedAt}</p></section><section><h2>同系列商品</h2>{related.length?<div class="product-grid">{related.map(p=><Card product={p}/>)}</div>:<p class="muted">本系列暂无其他已收录条目。</p>}</section><Sources sources={p.sources}/></>}</Base>
<style>
.buy-box{border:1px solid var(--accent);background:var(--soft);padding:14px 16px 13px;margin:22px 0 4px}
.buy-kicker{display:inline-block;background:var(--accent);color:#fff;font:700 .78rem/1 var(--ui);letter-spacing:.14em;padding:6px 11px;margin-bottom:11px}
.buy-links{display:flex;flex-wrap:wrap;gap:10px}
.buy-btn{display:flex;align-items:center;gap:10px;flex-wrap:wrap;max-width:100%;background:#fff;border:1.5px solid var(--accent);padding:9px 13px;text-decoration:none;color:var(--ink);transition:background .15s,transform .15s,box-shadow .15s}
.buy-btn:hover{background:var(--accent);color:#fff;transform:translateY(-1px);box-shadow:0 3px 10px rgba(105,80,131,.24)}
.buy-btn:hover .buy-host{color:#e6dcf0}
.buy-btn:hover .buy-go{border-color:#fff;color:#fff}
.buy-shop{min-width:0;overflow-wrap:anywhere}
.buy-host{min-width:0;overflow-wrap:anywhere}
.buy-shop{font-weight:700;font-size:.95rem}
.buy-host{font-size:.72rem;color:var(--muted)}
.buy-go{margin-left:2px;font-size:.72rem;font-weight:700;border:1px solid var(--accent);border-radius:999px;padding:2px 8px;color:var(--accent)}
.buy-note{display:block;margin-top:10px;font-size:.75rem;color:#6b5f75;line-height:1.6}
</style>

