---
import Base from '../../layouts/Base.astro';import Card from '../../components/ProductCard.astro';import Sources from '../../components/Sources.astro';import {products,series} from '../../lib/data';import {dateText,displayName,priceText,usableBrand} from '../../lib/catalog';
export function getStaticPaths(){return products.map(p=>({params:{slug:p.slug},props:{p}}));}const {p}=Astro.props;const s=series.find(s=>s.id===p.seriesId)!;const related=products.filter(x=>x.id!==p.id&&(x.seriesId===p.seriesId||p.relatedProductIds.includes(x.id)));const first=p.releases.find(r=>r.kind==='初版')!;const buy=[...new Map(p.sources.filter(x=>!/prtimes\.jp|aot-portal\.com/.test(x.url)).map(x=>[x.url.replace(/\/+$/,'').split('#')[0].toLowerCase(),x])).values()];
---
<Base title={displayName(p)} description={p.description}><div class="breadcrumbs"><a href="/merch/">周边图录</a><span>/</span><a href={'/series/'+s.slug+'/'}>{s.name}</a></div><section class="product-detail"><div class="detail-gallery">{p.images.length?p.images.map(img=><figure><img src={img.path} alt={img.alt}/><figcaption>{img.credit} · {img.usage} <a href={img.sourceUrl} target="_blank" rel="noopener noreferrer">图片来源 ↗</a>{img.originalUrl&&<> · <a href={img.originalUrl} target="_blank" rel="noopener noreferrer">原图网址 ↗</a></>}</figcaption></figure>):<div class="placeholder large"><span class="frame-icon">▧</span><span>商品图片待补充</span><small>等待可使用的官方图片或自有实拍</small></div>}</div><div class="detail-info"><span class="eyebrow">{p.type} / {p.region}</span><h1>{displayName(p)}</h1><p class="ja">{p.names.ja}</p><p>{p.description}</p><dl><div><dt>可购买的网站</dt><dd class="release-sources">{buy.map((source,i)=><>{i>0&&' · '}<a href={source.url} target="_blank" rel="noopener noreferrer">{source.organization} ↗</a></>)}</dd></div><div><dt>官方售价</dt><dd>{priceText(first)}{p.releases.length>1&&`（另有 ${p.releases.length-1} 次发行，见下方记录）`}</dd></div><div><dt>发售日</dt><dd>{first.releaseDate?dateText(first.releaseDate):(p.specifications['发售窗口']?'未公布，仅有滚动发售窗口（见下方规格）':'日期待确认')}</dd></div><div><dt>系列</dt><dd><a href={'/series/'+s.slug+'/'}>{s.name}</a></dd></div><div><dt>制造商</dt><dd>{usableBrand(p.manufacturer)?<a href={'/merch/?q='+encodeURIComponent(p.manufacturer!)}>{p.manufacturer}</a>:(p.manufacturer||'待核实')}</dd></div><div><dt>发行方</dt><dd>{usableBrand(p.publisher)?<a href={'/merch/?q='+encodeURIComponent(p.publisher!)}>{p.publisher}</a>:(p.publisher||'待核实')}</dd></div>{Object.entries(p.specifications).map(([k,v])=><div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>{p.isDemo&&<p class="notice">示例数据，不是真实商品。</p>}{p.missingFields.length>0&&<div class="notice"><strong>待核实项目</strong><ul>{p.missingFields.map(x=><li>{x}</li>)}</ul></div>}</div></section><section class="release-section"><div class="section-heading"><div><span class="eyebrow">RELEASE HISTORY</span><h2>发行与官方价格记录</h2></div><span>{p.releases.length} 次发行</span></div><p>以下为各次发行的官方标价，单位与税务状态分别保留。</p>{p.releases.map(r=><article class="release-card"><div class="release-date"><span class="tag">{r.kind}</span><h3>{dateText(r.releaseDate)}</h3><small>{r.region} · {r.salesMethod}</small></div><div><strong class="price">{priceText(r)}</strong><dl><div><dt>公告日期</dt><dd>{dateText(r.announcement)}</dd></div><div><dt>预订区间</dt><dd>{dateText(r.preorderStart)} — {dateText(r.preorderEnd)}（日本时区）</dd></div><div><dt>限定范围</dt><dd>{r.limitedScope||'官方来源未注明'}</dd></div>{r.condition&&<div><dt>获取条件</dt><dd>{r.condition}</dd></div>}</dl><div class="release-sources">{r.sourceIds.map(id=>{const source=p.sources.find(x=>x.id===id)!;return <a href={source.url} target="_blank" rel="noopener noreferrer">{source.title} ↗</a>})}</div></div></article>)}</section><section class="article"><h2>版本说明</h2><p>本条目按同一商品保留发行记录。不同年份的官方价格分别展示；设计或规格发生实质变化时，将另建条目并关联。</p><p>收录于 {p.createdAt} · 更新于 {p.updatedAt}</p></section><section><h2>同系列商品</h2>{related.length?<div class="product-grid">{related.map(p=><Card product={p}/>)}</div>:<p class="muted">本系列暂无其他已收录条目。</p>}</section><Sources sources={p.sources}/></Base>

