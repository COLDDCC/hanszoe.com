---
// 根路径 / ：默认进入日文首页 /ja/；访客手动选过中文（localStorage hz-lang=zh）则进入 /zh/。
// 无 JS 时用 meta refresh 进入 /ja/；页面本身给出两种语言的入口，并以 /ja/ 为 canonical。
const site = Astro.site;
const ja = site ? new URL('/ja/', site).href : '/ja/';
---
<!doctype html><html lang="ja"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>ハンジ・ゾエ アーカイブ｜韩吉档案馆</title><link rel="canonical" href={ja}/><link rel="icon" href="/favicon.ico" sizes="any"/>
<script is:inline>(()=>{let to="/ja/";try{if(localStorage.getItem("hz-lang")==="zh")to="/zh/"}catch(e){}location.replace(to+location.search+location.hash)})();</script>
<noscript><meta http-equiv="refresh" content="0; url=/ja/"/></noscript>
<style>body{margin:0;min-height:100vh;display:grid;place-items:center;background:#f1e8f8;color:#302b36;font:16px/1.8 -apple-system,BlinkMacSystemFont,"Segoe UI","Hiragino Kaku Gothic ProN","Microsoft YaHei",sans-serif;text-align:center}h1{font:800 1.6rem/1.4 "Hiragino Mincho ProN","Yu Mincho","Songti SC",serif;margin:0 0 16px}a{color:#7b3fa6;font-weight:700;margin:0 12px}</style>
</head><body><main><h1>ハンジ・ゾエ アーカイブ</h1><p><a href="/ja/" lang="ja">日本語</a><a href="/zh/" lang="zh-Hans">中文</a></p></main></body></html>
