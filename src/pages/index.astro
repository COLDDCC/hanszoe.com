---
import Base from '../layouts/Base.astro';import HansMark from '../components/HansMark.astro';import {webpSize} from '../lib/imageSize';import Card from '../components/ProductCard.astro';import {products,series} from '../lib/data';import {getCollection} from 'astro:content';const news=(await getCollection('news',x=>!x.data.isDemo)).sort((a,b)=>b.data.publishedAt.localeCompare(a.data.publishedAt));
// 最新收录：与图录页「最新收录」排序一致（按收录日 createdAt 倒序）。
const latest=[...products].sort((a,b)=>b.createdAt.localeCompare(a.createdAt)).slice(0,4);
// 系列：首页只展示最近有新收录的 6 个系列，其余从「全部系列」进入。
const seriesStats=new Map(series.map(s=>[s.id,{count:0,latest:''}]));
for(const p of products){const st=seriesStats.get(p.seriesId);if(st){st.count++;if(p.createdAt>st.latest)st.latest=p.createdAt;}}
const featuredSeries=series.filter(s=>seriesStats.get(s.id)!.count>0).sort((a,b)=>seriesStats.get(b.id)!.latest.localeCompare(seriesStats.get(a.id)!.latest)||seriesStats.get(b.id)!.count-seriesStats.get(a.id)!.count).slice(0,6);
// 首屏（杂志封面式）：最新一条带封面的资讯做头条；右栏再取 3 条带封面的资讯；中栏为其余最新 5 条，只列日期与标题。
const withCover=news.filter(n=>n.data.cover);
const lead=withCover[0];const rail=withCover.slice(1,4);const [pairA,pairB,feature]=rail;
const shown=new Set([lead,...rail].filter(Boolean).map(n=>n!.data.slug));
const textList=news.filter(n=>!shown.has(n.data.slug)).slice(0,5);
const restNews=news.filter(n=>!shown.has(n.data.slug)&&!textList.includes(n));
const months=['JANUARY','FEBRUARY','MARCH','APRIL','MAY','JUNE','JULY','AUGUST','SEPTEMBER','OCTOBER','NOVEMBER','DECEMBER'];
const longDate=(v:string)=>{const [y,m,d]=v.split('-');return m&&d?`${months[+m-1]} ${+d}, ${y}`:v;};
const dotDate=(v:string)=>v.replaceAll('-','.');
const sourceOf=(n:typeof news[number])=>n.data.sources[0]?.organization;
const href=(n:typeof news[number])=>'/news/'+n.data.slug+'/';
const dim=(n:typeof news[number])=>(n.data.cover&&webpSize(n.data.cover.path))||{};
---
<Base home><section class="cover" aria-label="最新资讯">
<div class="cover-lead">
<p class="cover-date">{lead?<time datetime={lead.data.publishedAt}>{longDate(lead.data.publishedAt)}</time>:'HANGE ARCHIVE'}</p>
<h1 class="cover-mark"><a href="/"><HansMark/><span class="sr-only">Hans · 韩吉档案馆</span></a></h1>
{lead&&<a class="cover-lead-story" href={href(lead)}><figure class="cover-lead-media"><img {...dim(lead)} src={lead.data.cover!.path} alt={lead.data.cover!.alt} loading="eager" fetchpriority="high" decoding="async"/></figure><span class="kicker">{lead.data.category}</span><h2>{lead.data.title}</h2><p>{lead.data.summary}</p>{sourceOf(lead)&&<small class="byline">出处 · {sourceOf(lead)}</small>}</a>}
</div>
<ol class="cover-list">{textList.map(n=><li><a href={href(n)}><time datetime={n.data.publishedAt}>{dotDate(n.data.publishedAt)}</time><h3>{n.data.title}</h3></a></li>)}<li class="cover-list-more"><a href="/news/">全部活动资讯 →</a></li></ol>
<div class="cover-rail">
{(pairA||pairB)&&<div class="cover-pair">{[pairA,pairB].filter(Boolean).map(n=><a class="cover-card" href={href(n!)}><span class="cover-card-media"><img {...dim(n!)} src={n!.data.cover!.path} alt={n!.data.cover!.alt} loading="lazy" decoding="async"/></span><span class="kicker">{n!.data.category}</span><h3>{n!.data.title}</h3></a>)}</div>}
{feature&&<a class="cover-feature" href={href(feature)}><span class="kicker">{feature.data.category}</span><h2>{feature.data.title}</h2><div class="cover-feature-body"><span class="cover-feature-media"><img {...dim(feature)} src={feature.data.cover!.path} alt={feature.data.cover!.alt} loading="lazy" decoding="async"/></span><p>{feature.data.summary}</p></div></a>}
</div>
</section><section class="home-intro"><div class="intro-copy"><div class="eyebrow">HANGE ZOË <span class="hero-name" lang="ja">ハンジ・ゾエ</span></div><h2 class="intro-title">关于韩吉，<br/>一件一件地记录。</h2><p>官方周边、发行记录与角色资料。<br/>为每一件收藏，留下一份有出处的档案。</p><div class="hero-actions"><a class="button secondary" href="/wiki/">查看原作档案</a><a class="button" href="/merch/">浏览周边图录</a></div><form class="search-bar" action="/merch/"><label class="sr-only" for="home-search">搜索周边</label><span aria-hidden="true">⌕</span><input id="home-search" name="q" placeholder="搜商品、系列或品牌，支持中 / 日 / 英文"/><button>搜索图录</button></form><div class="search-hints"><span>试试：</span><a href="/merch/?q=1123">黏土人 1123</a><a href="/merch/?q=ハンジ">ハンジ</a></div></div><aside class="archive-note"><span class="note-number">01 / ARCHIVE</span><div class="glasses" aria-hidden="true"><i></i><i></i></div><h2>让喜欢有迹可循。</h2><p>只记录发行时官方价格<br/>区分初版、再贩与不同版本<br/>未知的信息，留待核实</p><div class="note-bottom">非官方 · 持续收录</div></aside></section><div class="archive-stats"><div><strong>{products.length.toString().padStart(2,'0')}</strong><span>已收录周边</span></div><div><strong>{series.length.toString().padStart(2,'0')}</strong><span>系列档案</span></div><div><strong>{products.reduce((n,p)=>n+p.releases.length,0).toString().padStart(2,'0')}</strong><span>发行记录</span></div><p>从小小的档案开始，<br/>慢慢补全每一段记录。</p></div><section><div class="section-heading"><div><span class="eyebrow">THE COLLECTION</span><h2>最新收录</h2></div><a href="/merch/">浏览全部周边</a></div><div class="home-catalog"><div class="product-grid">{latest.map(p=><Card product={p}/>)}</div><aside class="collection-note"><span class="eyebrow">收藏之前，先看出处</span><h3>同一件周边，<br/>可以有不同发行记录。</h3><p>原价跟随每次发行保存。整盒、盲抽和特典，各自保留官方公布的单位。</p><a class="text-link" href="/about/">了解收录规则</a></aside></div></section><section class="two-columns"><div><div class="section-heading"><div><span class="eyebrow">SERIES FILES</span><h2>系列档案</h2></div><a href="/series/">全部 {series.length} 个系列</a></div>{featuredSeries.map((s,i)=><a class="series-row" href={'/series/'+s.slug+'/'}><span class="row-number">{String(i+1).padStart(2,'0')}</span><div><h3>{s.name}</h3><p>{s.type} · 日本 · {seriesStats.get(s.id)!.count} 件周边</p></div><span>查看档案</span></a>)}</div><div><div class="section-heading"><div><span class="eyebrow">NEWS & RELEASES</span><h2>活动资讯</h2></div><a href="/news/">全部活动资讯</a></div>{restNews.slice(0,3).map(n=><a class="news-row" href={'/news/'+n.data.slug+'/'}><small>{n.data.category} · {n.data.publishedAt}</small><h3>{n.data.title}</h3><p>{n.data.summary}</p></a>)}</div></section><section class="wiki-strip"><div><span class="eyebrow">THE PERSON BEHIND THE COLLECTION</span><h2>不止是周边，也是韩吉。</h2><p>名称索引、基础资料与登场记录，逐条核对，慢慢整理。</p></div><a class="button light" href="/wiki/">查看原作档案</a></section></Base>
