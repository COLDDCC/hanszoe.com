---
import Base from '../../layouts/Base.astro';import {getCollection} from 'astro:content';const entries=(await getCollection('news',e=>!e.data.isDemo)).sort((a,b)=>b.data.publishedAt.localeCompare(a.data.publishedAt)||b.data.updatedAt.localeCompare(a.data.updatedAt));const cards=entries.flatMap(e=>{const c=e.data.cover;return c?[{e,c}]:[]});const featured=cards.slice(0,4);const [lead,...picks]=featured;const featuredIds=new Set(featured.map(x=>x.e.data.slug));const coverOf=new Map(cards.map(({e,c})=>[e.data.slug,c]));const rest=entries.filter(e=>!featuredIds.has(e.data.slug));
---
<Base title="活动资讯"><div class="page-heading"><span class="eyebrow">NEWS & RELEASES</span><h1>活动资讯</h1><p>新品、再贩与活动的档案，保留关键日期与官方出处。</p></div>
{lead&&<a class="news-lead" href={'/news/'+lead.e.data.slug+'/'}><div class="news-lead-media"><img src={lead.c.path} alt={lead.c.alt} loading="eager"/></div><div class="news-lead-copy"><span class="eyebrow">{lead.e.data.category} · {lead.e.data.publishedAt}</span><h2>{lead.e.data.title}</h2><p>{lead.e.data.summary}</p><span class="text-link">阅读档案</span></div></a>}
{picks.length>0&&<div class="news-picks">{picks.map(({e,c})=><a class="news-pick" href={'/news/'+e.data.slug+'/'}><div class="news-pick-media"><img src={c.path} alt={c.alt} loading="lazy"/></div><span class="eyebrow">{e.data.category} · {e.data.publishedAt}</span><h2>{e.data.title}</h2><p>{e.data.summary}</p></a>)}</div>}
{rest.length>0&&<div class="article-list">{rest.map(e=>{const cov=coverOf.get(e.data.slug);return <a class="news-row" class:list={[{'has-thumb':!!cov}]} href={'/news/'+e.data.slug+'/'}>{cov&&<span class="news-row-thumb"><img src={cov.path} alt={cov.alt} loading="lazy"/></span>}<span class="news-row-body"><small>{e.data.publishedAt} · { e.data.category }</small><h2>{e.data.title}</h2><p>{e.data.summary}</p><span class="text-link">阅读档案</span></span></a>})}</div>}
{!entries.length&&<div class="empty">资料正在整理，核实后将收录在这里。</div>}</Base>
