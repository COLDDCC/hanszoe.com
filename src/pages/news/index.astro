---
import Base from '../../layouts/Base.astro';
import NewsCover from '../../components/NewsCover.astro';
import NewsMark from '../../components/NewsMark.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { pickCover, dotDate } from '../../lib/newsCover';
import { webpSize } from '../../lib/imageSize';
type News = CollectionEntry<'news'>;
const entries = (await getCollection('news', e => !e.data.isDemo)).sort((a, b) => b.data.publishedAt.localeCompare(a.data.publishedAt) || b.data.updatedAt.localeCompare(a.data.updatedAt));
// 顶部杂志封面区用掉的条目，下方列表不再重复。
const { used } = pickCover(entries);
const feed = entries.filter(e => !used.has(e.data.slug));
const href = (n: News) => '/news/' + n.data.slug + '/';
const sourceOf = (n: News) => n.data.sources[0]?.organization;
const dim = (n: News) => (n.data.cover && webpSize(n.data.cover.path)) || {};
---
<Base title="活动资讯" description="韩吉·佐耶相关的新品、预订、再贩与活动资讯，按发布日期整理，每条保留关键日期与官方出处。">
<div class="channel-head">
<div class="channel-copy"><span class="eyebrow">NEWS & RELEASES</span><h1>活动资讯</h1><p>新品、再贩与活动的档案，保留关键日期与官方出处。共 {entries.length} 条。</p></div>
<div class="channel-mark"><NewsMark/></div>
</div>
{entries.length > 0 && <NewsCover news={entries} label="最新活动资讯"/>}
{feed.length > 0 && <section class="feed" aria-labelledby="feed-title"><h2 class="feed-title" id="feed-title">全部资讯 <span>{feed.length}</span></h2>
{feed.map(n => <a class="feed-row" href={href(n)}>
<div class="feed-thumb">{n.data.cover ? <img {...dim(n)} src={n.data.cover.path} alt={n.data.cover.alt} loading="lazy" decoding="async"/> : <span class="feed-thumb-empty" aria-hidden="true">{n.data.category}</span>}</div>
<div class="feed-main"><span class="kicker">{n.data.category}</span><h3>{n.data.title}</h3></div>
<div class="feed-aside"><time datetime={n.data.publishedAt}>{dotDate(n.data.publishedAt)}</time>{sourceOf(n) && <small class="byline">出处 · {sourceOf(n)}</small>}<p>{n.data.summary}</p></div>
</a>)}
</section>}
{!entries.length && <div class="empty">资料正在整理，核实后将收录在这里。</div>}
</Base>
