---
import Base from '../../layouts/Base.astro';import Sources from '../../components/Sources.astro';import Card from '../../components/ProductCard.astro';import {getCollection,render} from 'astro:content';import {products,series} from '../../lib/data';
export async function getStaticPaths(){return (await getCollection('news',e=>!e.data.isDemo)).map(entry=>({params:{slug:entry.data.slug},props:{entry}}));}const {entry}=Astro.props;const {Content}=await render(entry);const d=entry.data;const s=series.find(s=>s.id===d.seriesId);
---
<Base title={d.title} description={d.summary}><div class="breadcrumbs"><a href="/news/">资讯</a><span>/</span><span>{d.category}</span></div><article class="article"><span class="eyebrow">{d.category} / {d.publishedAt}</span><h1>{d.title}</h1><p class="lead">{d.summary}</p><div class="notice">发行档案 · 不代表当前库存或销售状态</div><h2>关键日期</h2><dl>{d.dates.map(x=><div><dt>{x.label}</dt><dd>{x.value}（{x.precision==='month'?'精确到月份 · ':''}{x.timezone}）</dd></div>)}<div><dt>销售方式</dt><dd>{d.salesMethod} · {d.region}</dd></div></dl><Content/>{s&&<p>系列：<a href={'/series/'+s.slug+'/'}>{s.name}</a></p>}</article><section><h2>关联周边</h2><div class="product-grid">{products.filter(p=>d.productIds.includes(p.id)).map(p=><Card product={p}/>)}</div></section><Sources sources={d.sources}/></Base>
