---
import Base from '../../layouts/Base.astro';import Card from '../../components/ProductCard.astro';import Sources from '../../components/Sources.astro';import {products,series} from '../../lib/data';import {getCollection} from 'astro:content';
export function getStaticPaths(){return series.map(s=>({params:{slug:s.slug},props:{s}}));}const {s}=Astro.props;const items=products.filter(p=>p.seriesId===s.id);const news=await getCollection('news',n=>!n.data.isDemo&&n.data.seriesId===s.id);
---
<Base title={s.name} description={s.description}><div class="breadcrumbs"><a href="/series/">系列档案</a><span>/</span><span>{s.type}</span></div><div class="page-heading"><span class="eyebrow">{s.region} / SERIES FILE</span><h1>{s.name}</h1><p>{s.description}</p></div><section><div class="section-heading"><h2>系列周边</h2><span>{items.length} 件收录</span></div>{items.length?<div class="product-grid">{items.map(p=><Card product={p}/>)}</div>:<div class="empty">该系列的商品资料正在核对。</div>}</section><section><h2>关联资讯</h2>{news.length?news.map(n=><a class="news-row" href={'/news/'+n.data.slug+'/'}><small>{n.data.category} · {n.data.publishedAt}</small><h3>{n.data.title}</h3><p>{n.data.summary}</p></a>):<p>暂无已收录资讯。</p>}</section><Sources sources={s.sources}/></Base>
